# Copiar a .env.production en el servidor (nunca se sube a git)
DOMAIN=finanzas.tudominio.com
ACME_EMAIL=tu-correo@tudominio.com

# Generar con: openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=

# Opcional: bucket S3 para copiar los respaldos diarios (requiere rol IAM en la instancia)
BACKUP_S3_BUCKET=

# --- Servidor compartido (otra app ya usa 80/443) ---
# Descomenta estas líneas: Cuadre no toma 80/443 (solo un puerto local para pruebas)
# y el proxy existente le reenvía el dominio (ver DEPLOY.md).
# SITE_ADDRESS=:80
# HTTP_BIND=127.0.0.1:8090
# HTTPS_BIND=127.0.0.1:8453
# Red de Docker del proxy existente (Caddy de voz-ia en ~/app → app_default)
# PROXY_NETWORK=app_default
